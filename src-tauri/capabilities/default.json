{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Permissions par défaut BCC Terminal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "updater:default",
    "window-state:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    }
  ]
}
